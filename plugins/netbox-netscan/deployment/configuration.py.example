# This file can be installed as configuration/netscan.py in netbox-docker.
from netbox.configuration.configuration import PLUGINS, PLUGINS_CONFIG

if "netbox_netscan" not in PLUGINS:
    PLUGINS.append("netbox_netscan")

PLUGINS_CONFIG["netbox_netscan"] = {
    # Start with the home network. Add the office networks after validation.
    "targets": [
        "192.168.100.0/24",
        # "192.168.1.0/24",
        # "192.168.5.0/24",
    ],
    "scheduled_scans": False,
    "allow_public_networks": False,
    "minimum_prefix_length": 24,
    "nmap_timing": "T3",
    "host_timeout": "90s",
    "scan_ports": [21, 22, 23, 53, 80, 139, 443, 445, 554, 631, 1883, 3389, 5900, 8080, 8443, 9100],
}
